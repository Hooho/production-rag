# 复制为 .env 后可直接用于本地开发；生产环境必须替换为独立的强密码和密钥。
# JWT_SECRET 是登录令牌的签名密钥，至少 32 字符；更换后所有用户需要重新登录。
JWT_SECRET=production-rag-local-jwt-secret-2026-change-me
# 首次启动时按这些密码创建用户：admin 是管理员，alice、bob 是演示用户。
# 用户已存在时不会被覆盖，之后改密码请用管理员在"设置 → 用户与部门"中修改。
ADMIN_PASSWORD=Admin12345678
ALICE_PASSWORD=Alice12345678
BOB_PASSWORD=Bob12345678
MYSQL_PASSWORD=MySQL12345678
MYSQL_ROOT_PASSWORD=MySQLRoot12345678
REDIS_PASSWORD=Redis12345678
LANGGRAPH_POSTGRES_PASSWORD=LangGraph12345678
API_PORT=8000
FRONTEND_PORT=3001

# 检索、回答流程、对话记忆、知识巡检的参数（阈值、开关、超时等）在 设置 → 系统参数 里修改，那里保存的值优先，
# 这里的值权重最低，只在设置页没改过时作为初始值；可改的项见 app/runtime_config.py。
# demo 无需外部模型：字符向量检索 + 原文摘录，不模拟数据库。
# openai 使用真实聊天模型；Embedding 可选择 local（本地下载 BGE）或 openai。
MODEL_MODE=demo
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# LangChain SummarizationMiddleware：达到 Token 阈值后压缩，并保留最近消息。
MEMORY_TRIGGER_TOKENS=2400
MEMORY_KEEP_MESSAGES=6
EMBEDDING_MODE=demo
EMBEDDING_URL=http://embedding:8090/v1
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
RERANK_MODE=local
# 开发集扫描显示 0.85 保持可回答题 Recall 1.0，并将无法回答题漏放率从 0.625 降到 0.25，因此采用该默认值。
RERANK_MIN_SCORE=0.85
RERANKER_MODEL=BAAI/bge-reranker-base
# 父子分块：检索用 800 字子块，交给回答模型前扩展为同一小节相邻分片组成的父块（约 2400 字）；off 关闭。
PARENT_CONTEXT=on
# Contextual Retrieval：导入时让聊天模型为每个分片写一两句上下文说明，拼在分片前参与向量和 BM25；
# 仅 MODEL_MODE=openai 时生效，会为每个新分片调用一次模型。修改后需用同一文件替换文档（或重新导入评测语料）才会生效；off 关闭。
CONTEXTUAL_RETRIEVAL=on
# 检索充分性判断：检索后让聊天模型判断资料够不够回答；不足时补充检索一次，仍不足则拒答。
# 仅 MODEL_MODE=openai 时生效，每次知识问答多一到两次模型调用；off 关闭。
SUFFICIENCY_CHECK=on
INTENT_MODE=local
# 本地轻量意图分类服务；低置信度时才升级到 DeepSeek。
INTENT_URL=http://intent:8091/v1
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# 如果 Docker 容器不能直接访问外网，填入内网代理；不需要代理时保持为空。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=mysql,redis,milvus,embedding,intent,localhost,127.0.0.1
# 可选：内网无法访问 Hugging Face 时，填写可访问的镜像地址。
HF_ENDPOINT=https://huggingface.co

# 知识巡检（python -m scripts.inspection 或「知识巡检」页）：扫描最近多少天的问答；
# 答不上来的问题与已有缺口的相似度达到 GAP_SIMILARITY 才合并；分片至少收到 MIN_NEGATIVE 条差评、
# 且差评占引用次数的比例达到 MIN_RATE 才列为可疑内容。
INSPECTION_DAYS=30
INSPECTION_GAP_SIMILARITY=0.75
INSPECTION_CONTENT_MIN_NEGATIVE=2
INSPECTION_CONTENT_MIN_RATE=0.3
# 拒答分类：提问人范围内最高分达到 RERANK_MIN_SCORE 的这个比例算"差一点就找到"（检索缺口）；
# 全库最高分低于 OUT_OF_SCOPE_SCORE 算"疑似超出范围"。需要启用重排（RERANK_MODE=local 且 EMBEDDING_MODE=local）。
INSPECTION_NEAR_MISS_RATIO=0.5
INSPECTION_OUT_OF_SCOPE_SCORE=0.05

# Compose 项目名固定为 production-rag：文件夹名是 PROD-RAG，不写的话会按 prod-rag 另起一套容器和空数据卷。
COMPOSE_PROJECT_NAME=production-rag

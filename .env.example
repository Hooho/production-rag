# 复制为 .env 后可直接用于本地开发；生产环境必须替换为独立的强密码和密钥。
# JWT_SECRET 是登录令牌的签名密钥，至少 32 字符；更换后所有用户需要重新登录。
JWT_SECRET=production-rag-local-jwt-secret-2026-change-me
# 首次启动时按这些密码创建用户：admin 是管理员，alice、bob 是演示用户。
# 用户已存在时不会被覆盖，之后改密码请用管理员在"设置 → 用户与部门"中修改。
ADMIN_PASSWORD=Admin12345678
ALICE_PASSWORD=Alice12345678
BOB_PASSWORD=Bob12345678
MYSQL_PASSWORD=MySQL12345678
MYSQL_ROOT_PASSWORD=MySQLRoot12345678
REDIS_PASSWORD=Redis12345678
LANGGRAPH_POSTGRES_PASSWORD=LangGraph12345678
API_PORT=8000
FRONTEND_PORT=3001

# 检索、回答流程、对话记忆、知识巡检的参数（阈值、开关、超时等）在 设置 → 系统参数 里修改，那里保存的值优先，
# 这里的值权重最低，只在设置页没改过时作为初始值；可改的项见 app/runtime_config.py。
# demo 无需外部模型：字符向量检索 + 原文摘录，不模拟数据库。
# openai 使用真实聊天模型；Embedding 可选择 local（本地下载 BGE）或 openai。
MODEL_MODE=demo
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBEDDING_MODE=demo
EMBEDDING_URL=http://embedding:8090/v1
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
RERANKER_MODEL=BAAI/bge-reranker-base
# 检索、分片、回答流程、对话记忆、知识巡检的参数（相关度阈值、父子分块、分片大小、意图识别开关等）
# 都在设置页「RAG 配置」「系统配置」里改，不在这里配置。
# 本地轻量意图分类服务；低置信度时才升级到 DeepSeek。
INTENT_URL=http://intent:8091/v1
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# 如果 Docker 容器不能直接访问外网，填入内网代理；不需要代理时保持为空。
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=mysql,redis,milvus,embedding,intent,localhost,127.0.0.1
# 可选：内网无法访问 Hugging Face 时，填写可访问的镜像地址。
HF_ENDPOINT=https://huggingface.co

# 知识巡检命令行（python -m scripts.inspection）默认扫描最近多少天的问答；判断阈值在设置页「RAG 配置 → 知识巡检」。
INSPECTION_DAYS=30

# Compose 项目名固定为 production-rag：文件夹名是 PROD-RAG，不写的话会按 prod-rag 另起一套容器和空数据卷。
COMPOSE_PROJECT_NAME=production-rag
